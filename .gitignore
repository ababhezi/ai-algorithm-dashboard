# Default: ignore everything at the repo root
/*

# Keep the app project files
!/.gitignore
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/vite.config.ts
!/vite.config.js
!/vite.config.d.ts
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/scripts/
!/scripts/**
!/public/
!/public/**
!/src/
!/src/**

# Analysis & presentation deliverables
!/DATASET_ANALYSIS.md
!/选题.md
!/figures/
!/figures/**
!/my-video/
!/my-video/**

# Generated / local artifacts inside allowed folders
node_modules/
dist/
.vercel/
*.log
*.err.log
*.tsbuildinfo
.DS_Store
Thumbs.db
.idea/
.vscode/
